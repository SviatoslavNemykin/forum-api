// use prisma-8

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  createdAt  String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   Int    // <-- поставь ?
  author     User?    @relation(fields: [authorId], references: [id]) // <-- поставь ?
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  posts        Post[]
}